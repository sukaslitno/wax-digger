{
  "manifest_version": 3,
  "name": "Wax Digger",
  "version": "1.0.1",
  "description": "Download albums & tracks through your local YTDLP GUI — popup controls plus a one-click ↓ button on badger.greenlight.hr.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Wax Digger",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs"],
  "host_permissions": [
    "http://localhost:7337/*",
    "http://127.0.0.1:7337/*",
    "https://badger.greenlight.hr/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://badger.greenlight.hr/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
